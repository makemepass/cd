//yacc without lex.y//
%{
#include <stdio.h>
#include <ctype.h>
int yylex();
void yyerror(char *s);
%}

%token DIGIT

%%
line: E '\n' { printf("Result = %d\n", $1); };
E: E '+' T { $$ = $1 + $3; } | T;
T: T '*' F { $$ = $1 * $3; } | F;
F: '(' E ')' { $$ = $2; } | DIGIT;
%%

int yylex() {
    int c = getchar();
    if (isdigit(c)) {
        yylval = c - '0';
        return DIGIT;
    }
    return c;
}

int main() { return yyparse(); }
void yyerror(char *s) { printf("Invalid expression\n"); }




