//bnf.y//
%{
#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    char op;
    int val;
    struct Node *l, *r;
} Node;

Node *root;
Node *make(char op, int val, Node *l, Node *r) {
    Node *n = malloc(sizeof(Node));
    n->op = op; n->val = val; n->l = l; n->r = r;
    return n;
}
void print(Node *n, int d) {
    if (!n) return;
    for (int i = 0; i < d; i++) printf("  ");
    if (n->op) printf("%c\n", n->op);
    else printf("%d\n", n->val);
    print(n->l, d+1);
    print(n->r, d+1);
}
int yylex(void);
void yyerror(char *s) { printf("Invalid expression\n"); }
%}

%union { int num; Node *node; }
%token <num> NUMBER
%type <node> E T F

%%
E: E '+' T { $$ = make('+', 0, $1, $3); }
 | T       { $$ = $1; };
T: T '*' F { $$ = make('*', 0, $1, $3); }
 | F       { $$ = $1; };
F: '(' E ')' { $$ = $2; }
 | NUMBER    { $$ = make(0, $1, NULL, NULL); };
%%

int main() {
    printf("Enter expression: ");
    if (!yyparse()) print(root, 0);
    return 0;
}







//bnf.l//
%{
#include <stdlib.h>
#include "y.tab.h"
%}

%%
[0-9]+  { yylval.num = atoi(yytext); return NUMBER; }
[ \t]   ;
\n      return 0;
.       return yytext[0];
%%
int yywrap() { return 1; }


//compilation steps//
yacc -d bnf.y
lex bnf.l
gcc y.tab.c lex.yy.c -o ast -ll
./ast
