##expr.y##
%{
#include <stdio.h>
#include <stdlib.h>

int yylex();
int yyerror(char *s);
%}

%token NUMBER

%left '+' '-'
%left '*' '/'
%right UMINUS

%%

expr:
      expr '+' expr          { $$ = $1 + $3; }
    | expr '-' expr          { $$ = $1 - $3; }
    | expr '*' expr          { $$ = $1 * $3; }
    | expr '/' expr          { $$ = $1 / $3; }
    | '(' expr ')'           { $$ = $2; }
    | '-' expr %prec UMINUS  { $$ = -$2; }
    | NUMBER                 { $$ = $1; }
    ;

%%

int main()
{
    printf("Enter expression: ");

    if (yyparse() == 0)
        printf("Valid expression\n");
    else
        printf("Invalid expression\n");

    return 0;
}

int yyerror(char *s)
{
    return 0;
}




