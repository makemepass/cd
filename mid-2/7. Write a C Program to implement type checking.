#include <stdio.h>
#include <string.h>

int main() {
    char t1[10], t2[10], op[5];
    scanf("%s %s %s", t1, op, t2);

    if ((!strcmp(t1,"int") || !strcmp(t1,"float")) &&
        (!strcmp(t2,"int") || !strcmp(t2,"float")))
        printf("Valid. Result: %s\n",
        (!strcmp(t1,"float") || !strcmp(t2,"float")) ? "float" : "int");
    else
        printf("Type mismatch error!\n");

    return 0;
}
