#include <stdio.h>
#include <string.h>

int main() {
    char type1[10], type2[10], op[5];
    
    printf("Enter type of operand 1 (int/float): ");
    scanf("%s", type1);
    
    printf("Enter operator (+, -, *, /): ");
    scanf("%s", op);
    
    printf("Enter type of operand 2 (int/float): ");
    scanf("%s", type2);

    // Basic type checking logic
    if (strcmp(type1, "float") == 0 || strcmp(type2, "float") == 0) {
        printf("Valid Expression. Resulting type: float\n");
    } else if (strcmp(type1, "int") == 0 && strcmp(type2, "int") == 0) {
        printf("Valid Expression. Resulting type: int\n");
    } else {
        printf("Type mismatch error!\n");
    }
    
    return 0;
}
