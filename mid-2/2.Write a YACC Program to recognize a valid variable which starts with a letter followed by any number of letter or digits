##var.y##
%{
#include <stdio.h>
int yylex(void);
int yyerror(char *s) { return 0; }
%}

%token LETTER DIGIT

%%
var: LETTER rest;
rest: LETTER rest | DIGIT rest | ;
%%

int main() {
    printf("Enter variable: ");
    if (!yyparse()) printf("Valid variable\n");
    else printf("Invalid variable\n");
    return 0;
}





##var.l##
%{
#include "y.tab.h"
%}

%%
[a-zA-Z]  return LETTER;
[0-9]     return DIGIT;
[ \t]     ;
\n        return 0;
.         return yytext[0];
%%




##compilation steps##
yacc -d var.y
lex var.l
cc y.tab.c lex.yy.c -o var -lfl
./var
