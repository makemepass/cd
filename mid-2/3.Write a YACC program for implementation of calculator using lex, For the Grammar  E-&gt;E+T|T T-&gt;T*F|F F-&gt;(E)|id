//yacc with lex.y//
%{
#include <stdio.h>
int yylex();
int yyerror(char *s);
%}

%union { int dval; }
%token <dval> DIGIT
%type <dval> E T F

%%
line: E '\n' { printf("Result = %d\n", $1); };
E: E '+' T { $$ = $1 + $3; } | T;
T: T '*' F { $$ = $1 * $3; } | F;
F: '(' E ')' { $$ = $2; } | DIGIT;
%%

int main() { return yyparse(); }
int yyerror(char *s) { printf("Invalid expression\n"); return 0; }





//yacc with lex.l//
%{
#include <stdio.h>
#include <stdlib.h>
#include "y.tab.h"
%}

%%
[0-9]+ { yylval.dval = atoi(yytext); return DIGIT; }
[ \t]  ;
\n     return '\n';
.      return yytext[0];
%%



//compilation steps//
yacc -d yacc.y
lex lex.l
lex.yy.c y.tab.c -ll -o a.out
./a.out
