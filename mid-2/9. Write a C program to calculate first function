
#include <stdio.h>
#include <ctype.h>

char p[10][10];
int n;

void first(char c) {
    if (!isupper(c)) {
        printf("%c ", c);
        return;
    }
    for (int i = 0; i < n; i++)
        if (p[i][0] == c && p[i][2] != c)
            first(p[i][2]);
}

int main() {
    char c;
    printf("Enter number of productions: ");
    scanf("%d", &n);
    printf("Enter productions (e.g., E=E+T):\n");
    for (int i = 0; i < n; i++) scanf("%s", p[i]);
    printf("Enter non-terminal: ");
    scanf(" %c", &c);
    printf("FIRST(%c) = { ", c);
    first(c);
    printf("}\n");
    return 0;
}
