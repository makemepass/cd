//C program to recognize vowel or consonant//

#include <stdio.h>
#include <ctype.h>
void main()
{
    char ch;
    printf("enter a char: ");
    scanf("%c", &ch);
    if (isalpha(ch))
    {
        if (ch == 'a' || ch == 'e' || ch == 'i' ||
            ch == 'o' || ch == 'u')
        {
            printf("%c is a vowel", ch);
        }
        else
        {
            printf("%c is a consonant", ch);
        }
    }
    else if (isdigit(ch))
    {
        printf("%c is digit", ch);
    }
    else
    {
        printf("special character");
    }
}
