//C program to implement RDP for grammar E->TE', E'->+TE'|E, T->FT', F->(E)|id, T'->*FT'|E//

#include <stdio.h>
#include <string.h>
char str[100];
int pos = 0;
int E();
int Eprime();
int T();
int Tprime();
int F();
int E()
{
    if (T())
    {
        if (Eprime())
            return 1;
    }
    return 0;
}
int Eprime()
{
    if (str[pos] == '+')
    {
        pos++;
        if (T())
        {
            if (Eprime())
                return 1;
        }
        return 0;
    }
    return 1;
}
int T()
{
    if (F())
    {
        if (Tprime())
            return 1;
    }
    return 0;
}
int Tprime()
{
    if (str[pos] == '*')
    {
        pos++;
        if (F())
        {
            if (Tprime())
                return 1;
        }
        return 0;
    }
    return 1;
}
int F()
{
    if (str[pos] == 'i' && str[pos + 1] == 'd')
    {
        pos = pos + 2;
        return 1;
    }
    if (str[pos] == '(')
    {
        pos++;

        if (E())
        {
            if (str[pos] == ')')
            {
                pos++;
                return 1;
            }
        }
    }
    return 0;
}
int main()
{
    printf("Enter the expression: ");
    scanf("%99s", str);
    pos = 0;
    if (E() && str[pos] == '\0')
        printf("Expression is accepted.\n");
    else
        printf("Expression is rejected.\n");
    return 0;
}
