//Lex program to identify Constants//

%{
#include <stdio.h>
%}

%%

"#define"[ \t]+[a-zA-Z_][a-zA-Z0-9_]*[ \t]+[0-9]+(\.[0-9]+)? {
    printf("constant");
}

"#define"[ \t]+[a-zA-Z_][a-zA-Z0-9_]*[ \t]+\"[^\n\"]*\" {
    printf("string constant");
}

.+ {
    printf("not a constant: %s", yytext);
}

%%

void main()
{
    yylex();
}
