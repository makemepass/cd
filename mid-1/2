//Lex program to recognize identifier or not//

%{
#include <stdio.h>
%}
letter  [a-zA-Z]
digit   [0-9]
key     (int|if|while|break|for|else|char|float|double|void)
%%
{key}                      { printf("%s is a keyword\n", yytext); }
{letter}({letter}|{digit})* { printf("%s is an identifier\n", yytext); }
%%
int main()
{
    yylex();
    return 0;
}
