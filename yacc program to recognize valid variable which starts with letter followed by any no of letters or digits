##var.y##
%{
#include <stdio.h>
#include <stdlib.h>

int yylex(void);
int yyerror(char *s);
%}

%token LETTER DIGIT

%%

variable : LETTER rest
         ;

rest : LETTER rest
     | DIGIT rest
     |
     ;

%%

int main()
{
    printf("Enter the variable: ");

    if (yyparse() == 0)
        printf("Valid variable\n");
    else
        printf("Invalid variable\n");

    return 0;
}

int yyerror(char *s)
{
    return 0;
}




##var.l##
%{
#include <stdio.h>
#include "y.tab.h"
%}

%%

[a-zA-Z]       { return LETTER; }
[0-9]          { return DIGIT; }
[ \t]          { /* ignore spaces and tabs */ }
\n             { return 0; }
.              { return yytext[0]; }

%%



##compilation steps##
yacc -d var.y
lex var.l
cc y.tab.c lex.yy.c -o var -lfl
./var
