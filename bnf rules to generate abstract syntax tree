//bnf.y//
%{
#include <stdio.h>
#include <stdlib.h>
typedef enum {
    AST_NUMBER,
    AST_BINARY
} ASTNodeType;
typedef struct ASTNode {
    ASTNodeType type;
    union {
        int number;
        struct {
            char op;
            struct ASTNode *left;
            struct ASTNode *right;
        } binary;
    };
} ASTNode;
ASTNode *root;
ASTNode *make_number(int value);
ASTNode *make_binary(char op, ASTNode *left, ASTNode *right);
void print_ast(ASTNode *node, int level);
void free_ast(ASTNode *node);
int yylex(void);
void yyerror(const char *s);
%}
%union {
    int number;
    ASTNode *node;
}
%token <number> NUMBER
%type <node> expr term factor
%left '+' '-'
%left '*' '/'
%%

program
    : expr
      {
          root = $1;
      }
    ;

expr
    : expr '+' term
      {
          $$ = make_binary('+', $1, $3);
      }
    | expr '-' term
      {
          $$ = make_binary('-', $1, $3);
      }
    | term
      {
          $$ = $1;
      }
    ;

term
    : term '*' factor
      {
          $$ = make_binary('*', $1, $3);
      }
    | term '/' factor
      {
          $$ = make_binary('/', $1, $3);
      }
    | factor
      {
          $$ = $1;
      }
    ;

factor
    : NUMBER
      {
          $$ = make_number($1);
      }
    | '(' expr ')'
      {
          $$ = $2;
      }
    ;

%%

ASTNode *make_number(int value)
{
    ASTNode *node;
    node = (ASTNode *)malloc(sizeof(ASTNode));
    if (node == NULL)
    {
        printf("Memory allocation failed\n");
        exit(1);
    }
    node->type = AST_NUMBER;
    node->number = value;
    return node;
}

ASTNode *make_binary(char op, ASTNode *left, ASTNode *right)
{
    ASTNode *node;
    node = (ASTNode *)malloc(sizeof(ASTNode));
    if (node == NULL)
    {
        printf("Memory allocation failed\n");
        exit(1);
    }
    node->type = AST_BINARY;
    node->binary.op = op;
    node->binary.left = left;
    node->binary.right = right;
    return node;
}

void print_ast(ASTNode *node, int level)
{
    int i;
    if (node == NULL)
        return;
    for (i = 0; i < level; i++)
        printf("  ");
    if (node->type == AST_NUMBER)
    {
        printf("NUMBER: %d\n", node->number);
    }
    else
    {
        printf("OPERATOR: %c\n", node->binary.op);

        print_ast(node->binary.left, level + 1);
        print_ast(node->binary.right, level + 1);
    }
}

void free_ast(ASTNode *node)
{
    if (node == NULL)
        return;
    if (node->type == AST_BINARY)
    {
        free_ast(node->binary.left);
        free_ast(node->binary.right);
    }
    free(node);
}
void yyerror(const char *s)
{
    printf("Syntax Error: %s\n", s);
}

int main()
{
    printf("Enter an arithmetic expression: ");
    yyparse();
    printf("\nAbstract Syntax Tree:\n");
    print_ast(root, 0);
    free_ast(root);
    return 0;
}






//bnf.l//
%{
#include <stdio.h>
#include <stdlib.h>
typedef enum {
    AST_NUMBER,
    AST_BINARY
} ASTNodeType;
typedef struct ASTNode {
    ASTNodeType type;
    union {
        int number;
        struct {
            char op;
            struct ASTNode *left;
            struct ASTNode *right;
        } binary;
    };
} ASTNode;

#include "y.tab.h"
%}

%%

[0-9]+ {
    yylval.number = atoi(yytext);
    return NUMBER;
}

[ \t]+ ;

"+" {
    return '+';
}

"-" {
    return '-';
}

"*" {
    return '*';
}

"/" {
    return '/';
}

"(" {
    return '(';
}

")" {
    return ')';
}

\n {
    return 0;
}

. {
    printf("Unknown character: %s\n", yytext);
}

%%

int yywrap()
{
    return 1;
}
