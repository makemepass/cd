//yacc with lex.y//
%{
/*E->E+E/E*E/(E)/DIGIT*/
%}
%union
{
int dval;
}
%token <dval> DIGIT
%type <dval> expr
%type <dval> term
%type <dval> factor
%%
line:expr '\n' {printf("%d",$1);exit(0);}
;
expr:expr '+' term {$$=$1+$3;}
|term
;
term:term '*' factor {$$=$1*$3;}
|factor
;
factor: '(' expr ')' {$$=$2;}
|DIGIT
;
%%
int main()
{
yyparse();
}
yyerror(char *s)
{
printf("%s",s);
}





//yacc with lex.l//
%{
#include<stdio.h>
#include "y.tab.h"
%}
%%
[0-9]+ {yylval.dval=atoi(yytext); return DIGIT;}
\n|. return yytext[0];
%%


//compilation steps//
yacc -d yacc.y
lex lex.l
lex.yy.c y.tab.c -ll -o a.out
./a.out




//yacc without lex.y//
%{
#include<stdio.h>
#include<ctype.h>
%}
%token DIGIT
%%
line:expr '\n' {printf("%d",$1);exit(0);}
;
expr:expr '+' term {$$=$1+$3;}
|term
;
term:term '*' factor {$$=$1*$3;}
|factor
;
factor: '(' expr ')' {$$=$2;}
|DIGIT
;
%%
yylex()
{
int c;
c=getchar();
if(isdigit(c))
{
yylval=c-'0';
return DIGIT;
}
return c;
}
void main()
{
yyparse();
}
void yyerror(char *s)
{
printf("%s",s);
}



//compilation steps//
yacc -d calc.y
cc y.tab.c -o calc
./calc
