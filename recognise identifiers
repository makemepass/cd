#include <stdio.h>
#include <ctype.h>
int main() {
    char str[100];
    int i = 0, valid = 1;
    printf("Enter an identifier: ");
    scanf("%99s", str);
    if (!(isalpha(str[0]) || str[0] == '_')) {
        valid = 0;
    } else {
        for (i = 1; str[i] != '\0'; i++) {
            if (!(isalnum(str[i]) || str[i] == '_')) {
                valid = 0;
                break;
            }
        }
    }
    if (valid)
        printf("%s is a valid identifier.\n", str);
    else
        printf("%s is not a valid identifier.\n", str);
    return 0;
}
