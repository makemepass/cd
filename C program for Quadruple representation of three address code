#include <stdio.h>
#include <string.h>
typedef struct {
    char op[10];
    char arg1[20];
    char arg2[20];
    char result[20];
} Quad;
int main() {
    char e[100];
    Quad q[50];
    int n = 0, t = 1;
    int i;

    printf("Enter expression: ");
    scanf("%s", e);
    int equalPos = -1;
    for (i = 0; e[i]; i++) {
        if (e[i] == '=') {
            equalPos = i;
            break;
        }
    }
    if (equalPos == -1) {
        printf("Invalid expression.\n");
        return 0;
    }
    char lhs = e[0];
    char rhs[100];
    strcpy(rhs, e + equalPos + 1);
    for (i = 0; rhs[i]; i++) {
        if (rhs[i] == '-' &&
            (i == 0 ||
             rhs[i - 1] == '+' ||
             rhs[i - 1] == '-' ||
             rhs[i - 1] == '*' ||
             rhs[i - 1] == '/')) {
            char operand = rhs[i + 1];
            sprintf(q[n].op, "uminus");
            sprintf(q[n].arg1, "%c", operand);
            sprintf(q[n].arg2, "-");
            sprintf(q[n].result, "t%d", t);
            rhs[i] = '0' + t;
            for (int j = i + 1; rhs[j]; j++)
                rhs[j] = rhs[j + 1];
            t++;
            n++;
        }
    }
    for (i = 0; rhs[i]; i++) {
        if (rhs[i] == '*' || rhs[i] == '/') {
            char op = rhs[i];
            char arg1 = rhs[i - 1];
            char arg2 = rhs[i + 1];
            sprintf(q[n].op, "%c", op);
            sprintf(q[n].arg1, "%c", arg1);
            sprintf(q[n].arg2, "%c", arg2);
            sprintf(q[n].result, "t%d", t);
            rhs[i - 1] = '0' + t;
            for (int j = i; rhs[j]; j++)
                rhs[j] = rhs[j + 2];
            t++;
            n++;
            i = -1;
        }
    }
    for (i = 0; rhs[i]; i++) {
        if (rhs[i] == '+' || rhs[i] == '-') {
            char op = rhs[i];
            char arg1 = rhs[i - 1];
            char arg2 = rhs[i + 1];
            sprintf(q[n].op, "%c", op);
            sprintf(q[n].arg1, "%c", arg1);
            sprintf(q[n].arg2, "%c", arg2);
            sprintf(q[n].result, "t%d", t);
            rhs[i - 1] = '0' + t;
            for (int j = i; rhs[j]; j++)
                rhs[j] = rhs[j + 2];
            t++;
            n++;
            i = -1;
        }
    }
    sprintf(q[n].op, "=");
    sprintf(q[n].arg1, "%c", rhs[0]);
    sprintf(q[n].arg2, "-");
    sprintf(q[n].result, "%c", lhs);
    n++;
    printf("\n========== THREE ADDRESS CODE ==========\n");
    for (i = 0; i < n; i++) {
        if (strcmp(q[i].op, "uminus") == 0) {
            printf("%s = -%s\n",
                   q[i].result,
                   q[i].arg1);
        }
        else if (strcmp(q[i].op, "=") == 0) {
            printf("%s = %s\n",
                   q[i].result,
                   q[i].arg1);
        }
        else {
            printf("%s = %s %s %s\n",
                   q[i].result,
                   q[i].arg1,
                   q[i].op,
                   q[i].arg2);
        }
    }
    printf("\n========== QUADRUPLES ==========\n");
    printf("%-10s %-10s %-10s %-10s\n",
           "Operator", "Arg1", "Arg2", "Result");
    for (i = 0; i < n; i++) {
        printf("%-10s %-10s %-10s %-10s\n",
               q[i].op,
               q[i].arg1,
               q[i].arg2,
               q[i].result);
    }
    return 0;
}
