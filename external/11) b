#include <stdio.h>
#include <string.h>
typedef struct { char op[8], a1[8], a2[8], r[8]; } Quad;
int main() {
    char e[100], rhs[100];
    Quad q[50];
    int n = 0, t = 1, i, k;
    printf("Enter expression: ");
    scanf("%s", e);
    char *eq = strchr(e, '=');
    if (!eq) return printf("Invalid expression.\n"), 0;
    strcpy(rhs, eq + 1);
    for (i = 0; rhs[i]; i++) {
        if (rhs[i] == '-' && (i == 0 || strchr("+-*/", rhs[i - 1]))) {
            sprintf(q[n].op, "uminus");
            sprintf(q[n].a1, "%c", rhs[i + 1]);
            strcpy(q[n].a2, "-");
            sprintf(q[n].r, "t%d", t);
            rhs[i] = '0' + t++;
            for (int j = i + 1; (rhs[j] = rhs[j + 1]); j++);
            n++;
        }
    }

    char *ops[] = {"*/", "+-"};
    for (k = 0; k < 2; k++) {
        for (i = 0; rhs[i]; i++) {
            if (strchr(ops[k], rhs[i])) {
                sprintf(q[n].op, "%c", rhs[i]);
                sprintf(q[n].a1, "%c", rhs[i - 1]);
                sprintf(q[n].a2, "%c", rhs[i + 1]);
                sprintf(q[n].r, "t%d", t);
                rhs[i - 1] = '0' + t++;
                for (int j = i; (rhs[j] = rhs[j + 2]); j++);
                n++;
                i = -1; 
            }
        }
    }

    strcpy(q[n].op, "=");
    sprintf(q[n].a1, "%c", rhs[0]);
    strcpy(q[n].a2, "-");
    sprintf(q[n].r, "%c", e[0]);
    n++;

    printf("\n========== THREE ADDRESS CODE ==========\n");
    for (i = 0; i < n; i++) {
        if (q[i].op[0] == 'u') printf("%s = -%s\n", q[i].r, q[i].a1);
        else if (q[i].op[0] == '=') printf("%s = %s\n", q[i].r, q[i].a1);
        else printf("%s = %s %s %s\n", q[i].r, q[i].a1, q[i].op, q[i].a2);
    }

    printf("\n========== QUADRUPLES ==========\n");
    printf("%-10s %-10s %-10s %-10s\n", "Operator", "Arg1", "Arg2", "Result");
    for (i = 0; i < n; i++)
        printf("%-10s %-10s %-10s %-10s\n", q[i].op, q[i].a1, q[i].a2, q[i].r);

    return 0;
}
