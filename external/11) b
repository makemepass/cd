#include <stdio.h>

struct Quadruple {
    char op[10];
    char arg1[10];
    char arg2[10];
    char result[10];
};

int main() {
    // A = -B * (C + D) requires 4 quadruples
    struct Quadruple q[4] = {
        {"uminus", "B",  "-",  "t1"},
        {"+",      "C",  "D",  "t2"},
        {"*",      "t1", "t2", "t3"},
        {"=",      "t3", "-",  "A"}
    };

    printf("Expression: A = -B * (C + D)\n\n");
    printf("Index\tOp\tArg1\tArg2\tResult\n");
    printf("--------------------------------------\n");
    
    for (int i = 0; i < 4; i++) {
        printf("(%d)\t%s\t%s\t%s\t%s\n",
               i, q[i].op, q[i].arg1, q[i].arg2, q[i].result);
    }
    
    return 0;
}
