#include <stdio.h>

int main() {
    char v1, op, v2, t1, t2;

    printf("Enter variable 1 and its type (i for int, f for float): ");
    scanf(" %c %c", &v1, &t1);
    printf("Enter variable 2 and its type (i for int, f for float): ");
    scanf(" %c %c", &v2, &t2);
    printf("Enter expression (e.g., a+b): ");
    scanf(" %c%c%c", &v1, &op, &v2);

    if ((t1 == 'i' || t1 == 'f') && (t2 == 'i' || t2 == 'f')) {
        if (t1 == t2)
            printf("Valid. Result type: %s\n", t1 == 'i' ? "int" : "float");
        else
            printf("Valid (Type Promoted). Result type: float\n");
    } else {
        printf("Error: Type mismatch!\n");
    }
    return 0;
}
