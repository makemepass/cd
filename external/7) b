#include <stdio.h>
struct Quadruple {
    char op[10];
    char arg1[10];
    char arg2[10];
    char result[10];
};
int main() {
    struct Quadruple q[6] = {
        {"uminus", "B",  "-",  "t1"},
        {"*",      "t1", "C",  "t2"},
        {"uminus", "B",  "-",  "t3"},
        {"*",      "t3", "C",  "t4"},
        {"+",      "t2", "t4", "t5"},
        {"=",      "t5", "-",  "A"}
    };
    printf("Expression: A = -B * C + -B * C\n\n");
    printf("Index\tOp\tArg1\tArg2\tResult\n");
    printf("--------------------------------------\n");
    for (int i = 0; i < 6; i++) {
        printf("(%d)\t%s\t%s\t%s\t%s\n",
               i, q[i].op, q[i].arg1, q[i].arg2, q[i].result);
    }
    return 0;
}
