//yacc with lex.y//
%{ 
#include <stdio.h> 
int yylex(); 
int yyerror(char *s); 
%} 
%token ID 
%% 
S: E             { printf("Result: %d\n", $1); }
 ; 
E: E '+' T       { $$ = $1 + $3; } 
| T             { $$ = $1; } 
; 
T: T '*' F       { $$ = $1 * $3; } 
| F             { $$ = $1; } 
; 
F: '(' E ')'     { $$ = $2; } 
| ID            { $$ = $1; } 
; 
%% 
int main() {    
printf("Enter expression: ");    
if (yyparse() != 0)        
    printf("Invalid expression\n");    
return 0; 
} 
int yyerror(char *s) {    
return 0; 
}





//yacc with lex.l//
%{ 
#include <stdlib.h> 
#include "y.tab.h" 
%}
 
%% 
[0-9]+      { yylval = atoi(yytext); return ID; } 
[ \t]       ; 
\n          { return 0; } 
.           { return yytext[0]; } 
%%



//compilation steps//
yacc -d yacc.y
lex lex.l
lex.yy.c y.tab.c -ll -o a.out
./a.out
