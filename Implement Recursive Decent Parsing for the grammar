 /* Grammar is S->(L)|a , L->L,S|S*/
#include <stdio.h>
#include <string.h>
char str[100];
int pos = 0;
int S();
int L();
int Lprime();
int S()
{
    if (str[pos] == 'a')
    {
        pos++;
        return 1;
    }
    if (str[pos] == '(')
    {
        pos++;

        if (L())
        {
            if (str[pos] == ')')
            {
                pos++;
                return 1;
            }
        }
    }
    return 0;
}
int L()
{
    if (S())
    {
        if (Lprime())
            return 1;
    }
    return 0;
}
int Lprime()
{
    if (str[pos] == ',')
    {
        pos++;
        if (S())
        {
            return Lprime();
        }
        return 0;
    }
    return 1;
}
int main()
{
    printf("Enter the string: ");
    scanf("%99s", str);
    pos = 0;
    if (S() && str[pos] == '\0')
        printf("String is accepted.\n");
    else
        printf("String is rejected.\n");
    return 0;
}
